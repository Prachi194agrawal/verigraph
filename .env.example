# Copy to .env. Docker Compose reads it, and so does the backend when you run it from backend/.

# --- Model providers (LiteLLM reads these directly) ------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a real model supported by your provider account, shown as the dashboard default.
# DEFAULT_MODEL=provider/model-name
# OpenRouter (model names start with "openrouter/"; names ending in ":free" cost nothing):
# OPENROUTER_API_KEY=
# Free tiers allow few calls per minute: concurrent calls per provider, and retries after an HTTP 429.
# LLM_PROVIDER_CONCURRENCY=groq=2,gemini=2,openrouter=2
# LLM_RATE_LIMIT_RETRIES=6
# Ollama: inside docker compose (--profile ollama) the default is http://ollama:11434.
# Running the backend on your machine with a local Ollama:
# OLLAMA_API_BASE=http://localhost:11434

# --- Local repositories ---------------------------------------------------------------------------
# Local-path repositories must be inside one of these folders (Docker default: /fixtures,/repos).
# Leave empty only for single-user local development: the API serves files from build checkouts.
# LOCAL_REPO_ROOTS=/fixtures,/repos

# --- GitHub (issues + PRs for the history layer) ---------------------------------------------------
# A token with no scopes is enough for public repos. Without it only ~40 anonymous API calls are spent.
GITHUB_TOKEN=

# --- Graph store -----------------------------------------------------------------------------------
NEO4J_PASSWORD=verigraph-password
POSTGRES_PASSWORD=verigraph
# NEO4J_URI=bolt://localhost:7687

# --- Results database (default when running locally: SQLite in backend/data/) ----------------------
# DATABASE_URL=postgresql+psycopg://verigraph:verigraph@localhost:5432/verigraph

# --- Embeddings ------------------------------------------------------------------------------------
# Small Docker image for first setup: set INSTALL_EMBEDDINGS=false AND EMBEDDING_MODEL=hash.
# Set INSTALL_EMBEDDINGS=true to opt into neural embeddings.
INSTALL_EMBEDDINGS=false
# nomic-ai/CodeRankEmbed (needs `pip install -e '.[embeddings]'`), jinaai/jina-code-embeddings-0.5b
# (set EMBEDDING_DIM=896), or "hash" for the dependency-free lexical embedder.
EMBEDDING_MODEL=hash
# Inputs are truncated to this many tokens (raise it on a GPU):
# EMBEDDING_MAX_TOKENS=512

# --- Call resolvers, tried in order -----------------------------------------------------------------
# RESOLVERS=scip,jedi,import,name

# --- Tracing: `docker compose --profile tracing up -d` creates a Langfuse project with these keys ----
# LANGFUSE_PUBLIC_KEY=pk-lf-verigraph-local
# LANGFUSE_SECRET_KEY=sk-lf-verigraph-local
# LANGFUSE_HOST=http://localhost:3001

# --- Shared deployment access and budgets ----------------------------------------------------------
# HTTP Basic authentication; use HTTPS for any remote deployment. Values stay on the server.
# API_USERS='{"demo":"replace-with-a-long-random-password","reviewer":"another-password"}'
# REQUIRE_AUTH=true
# Anonymous reads reveal all analyzed data: enable only with public sample repositories.
# DEMO_READ_ONLY=false
# API_DAILY_WRITE_LIMIT=100
# Deployment-wide real provider attempts/day (UTC); 0 disables the cap for local development.
# LLM_DAILY_CALL_LIMIT=100
# MAX_EXPERIMENT_ANSWERS=100
# MAX_REPO_FILES=5000
# MAX_REPO_BYTES=100000000
# Production override uses HTTPS on this hostname and /backend for the API.
# DOMAIN=verigraph.example.com
